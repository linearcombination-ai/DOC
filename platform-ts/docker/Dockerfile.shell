# syntax=docker/dockerfile:1.7
# The API image of the TypeScript build: the Hono shell plus the LIGHT Rust core (compiled to wasm: request keys, catalog, book lists).
# No Python, no compiler in the final image. Build context: the repository root.
#   docker build -f platform-ts/docker/Dockerfile.shell -t doc-ts/api:local .
ARG RUST_IMAGE=rust:1.100.0-slim-bookworm
ARG NODE_IMAGE=node:26.13.1-bookworm-slim

# ---- stage 1: Rust core -> wasm (light module only) ----
FROM ${RUST_IMAGE} AS wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG WASM_BINDGEN_VERSION=0.2.130
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
# wasm-bindgen CLI: the exact version Cargo.lock pins, from its release page (prebuilt; compiling it takes minutes)
RUN set -eu; \
    case "$(uname -m)" in x86_64) triple=x86_64-unknown-linux-musl ;; aarch64) triple=aarch64-unknown-linux-gnu ;; *) echo "unsupported arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://github.com/rustwasm/wasm-bindgen/releases/download/${WASM_BINDGEN_VERSION}/wasm-bindgen-${WASM_BINDGEN_VERSION}-${triple}.tar.gz" \
      | tar -xz -C /usr/local/bin --strip-components=1 "wasm-bindgen-${WASM_BINDGEN_VERSION}-${triple}/wasm-bindgen"; \
    wasm-bindgen --version
WORKDIR /src/platform-ts
# scripture-kitchen, pinned commit, public repository (a read-only dependency of the core)
COPY platform-ts/scripts/fetch-kitchen.sh scripts/fetch-kitchen.sh
RUN bash scripts/fetch-kitchen.sh
COPY platform-ts/core core
COPY platform-ts/scripts/build-wasm.sh scripts/build-wasm.sh
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/platform-ts/core/target \
    CARGO_BUILD_JOBS="$(nproc)" WASM_ONLY=api WASM_BINDGEN=/usr/local/bin/wasm-bindgen bash scripts/build-wasm.sh

# ---- stage 2: production node_modules ----
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY platform-ts/package.json platform-ts/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --no-audit --no-fund

# ---- stage 3: the API image ----
FROM ${NODE_IMAGE} AS api
# git: the lookups that read repositories (book_codes_for_lang_from_usfm_only, chapters_in_books) clone them, as DOC's API does
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=18301 \
    DOC_MODE=fixed \
    DOCUMENT_OUTPUT_DIR=/data/output \
    WORKING_DIR=/data/work \
    RESOURCE_ASSETS_DIR=/data/assets
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=wasm /src/platform-ts/core/pkg-api ./core/pkg-api
COPY platform-ts/package.json ./
COPY platform-ts/src ./src
RUN mkdir -p /data/output /data/work /data/assets && chown -R 1000:1000 /data /app
USER 1000:1000
EXPOSE 18301
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 CMD ["node", "src/healthcheck.ts"]
CMD ["node", "src/main.ts"]
