# Copy to .env to override. Every variable is optional; the values shown are the defaults.
# DATA_API_URL=https://api.bibleineverylanguage.org/v1/graphql
# ASSET_CACHING_PERIOD=30                 # minutes: DOC's cache window for documents and repository copies
# DOC_SHELL_MODE=fixed                    # fixed (production behaviour) or as_built (emulates DOC's defects; comparison only)
# BACKEND_CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]
# API_HOST_PORT=5005  FILESERVER_HOST_PORT=8089  FRONTEND_HOST_PORT=8001
# PUBLIC_BACKEND_API_URL=http://localhost:5005   PUBLIC_FILE_SERVER_URL=http://localhost:8089
# WORKER_CONCURRENCY=2  PYWORKER_CONCURRENCY=2
# API_MEM=768m  WORKER_MEM=1g  PYWORKER_MEM=3g  VALKEY_MEM=256m  FRONTEND_MEM=384m
# SEND_EMAIL=false  SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_TLS=starttls  FROM_EMAIL_ADDRESS=
