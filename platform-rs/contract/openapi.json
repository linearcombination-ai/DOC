{
  "openapi": "3.1.0",
  "info": {
    "title": "DOC shell (Rust, P4)",
    "description": "Endpoints 1 to 7 of the DOC stack report, behaviour-compatible with DOC's FastAPI in `as_built` mode.",
    "license": {
      "name": ""
    },
    "version": "0.0.4"
  },
  "paths": {
    "/book_codes_for_lang/{lang_code}": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Books available for a language, with names as the resources provide them.",
        "operationId": "book_codes_for_lang",
        "parameters": [
          {
            "name": "lang_code",
            "in": "path",
            "description": "language code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Doc-Mode",
            "in": "header",
            "description": "as_built (default) or fixed",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Mode"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "book code and name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookEntry"
                  }
                }
              }
            }
          },
          "422": {
            "description": "invalid path parameter (fixed mode)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationBody"
                }
              }
            }
          },
          "503": {
            "description": "data API unavailable (fixed mode)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableBody"
                }
              }
            }
          }
        }
      }
    },
