        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "description": "`[resource type code, resource type name]`",
              "maxItems": 2,
              "minItems": 2
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          }
        }
      }
    }
  }
